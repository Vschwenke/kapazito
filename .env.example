# Kapazito — Beispiel-Environment-Datei
# Alle Werte beim Bootstrap ersetzen und .env NICHT ins Git einchecken.

# Datenbank (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/kapazito?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="openssl rand -base64 32 — hier echten Wert setzen"

# LLM-Provider (Anthropic primär, OpenAI Fallback)
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
LLM_PROVIDER="anthropic"     # anthropic | openai
LLM_MODEL="claude-3-5-sonnet-20241022"

# E-Mail-Versand (Resend)
RESEND_API_KEY=""
MAIL_FROM="Kapazito <hello@kapazito.de>"

# File-Storage (optional: S3/R2)
STORAGE_PROVIDER="local"     # local | s3 | r2
STORAGE_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="eu-central-1"

# Stripe (Billing) — später
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Sentry (Observability)
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""

# Rate-Limit (Upstash Redis)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Feature-Flags
KAPI_APPROVAL_REQUIRED="true"
MULTI_TENANCY_ENFORCED="true"
